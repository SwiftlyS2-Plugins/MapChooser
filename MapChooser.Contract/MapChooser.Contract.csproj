<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>MapChooser.Contract</AssemblyName>
    <RootNamespace>MapChooser.Contract</RootNamespace>
    <!-- AssemblyVersion stays 1.0.0.0: plugins built against an older contract keep binding to the exported one. -->
    <Version>1.1.0</Version>
    <FileVersion>1.1.0.0</FileVersion>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- The XML is worth shipping for the members that carry a real doc comment, without writing
         "Gets the total." on every self-explanatory one. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <OutputPath>$(MSBuildThisFileDirectory)build/</OutputPath>
    <AppendTargetFrameworkToOutputPath>true</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <!-- Separate from the plugin assembly because a consumer has to name IMapChooserApi at compile
       time, and referencing MapChooser.dll itself would put a second copy of the plugin on the
       server. References nothing, so it stays independent of SwiftlyS2 versions. -->

</Project>
